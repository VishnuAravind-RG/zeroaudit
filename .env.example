# ZEROAUDIT configuration template.
# Generate a real one with:  python -m scripts.gen_keys > .env
#
# .env is gitignored. .env.example is not, and must never hold real secrets.

# -- Key material (prover only) ----------------------------------------------
# 32-byte hex. HMAC key for per-transaction blinding factors.
ZEROAUDIT_MASTER_KEY=
# 32-byte hex. Seed for the Module-LWE public matrix and secret vector.
LWE_SEED_HEX=
# 32-byte base64. Ed25519 seed for signing published commitments.
SGX_SIGNING_KEY_B64=

# -- Pipeline ----------------------------------------------------------------
SIM_TPS=15
SIM_ANOMALY_RATE=0.05
ANOMALY_THRESHOLD=0.75
INGRESS_REQUIRE_SIGNATURE=false
LOG_LEVEL=INFO

# -- Sanctions graph (Neo4j, loaded with the real OFAC SDN list) -------------
# Not a cryptographic secret - just the demo database's own credential.
# Change it for anything beyond a local run.
NEO4J_PASSWORD=zeroaudit-demo
